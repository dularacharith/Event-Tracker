# ==============================================================================
# CampaignFlow Environment Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (Neon Postgres via Vercel Marketplace)
# ------------------------------------------------------------------------------
# Pooled connection string that supports interactive transactions.
# In Vercel, this is automatically provided when connecting Neon Postgres.
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
POSTGRES_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. Authentication (Better Auth with Google OAuth)
# ------------------------------------------------------------------------------
# Secret key used for signing cookies and session tokens.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-32-byte-secret-key-here"

# Canonical base URL for your application
# Local dev: http://localhost:3000
# Production: https://your-project.vercel.app
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Cloud Console OAuth 2.0 Credentials
# Authorized redirect URI: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ------------------------------------------------------------------------------
# 3. First Admin Email Bootstrap
# ------------------------------------------------------------------------------
# Exactly one email address is configured to bootstrap the first workspace Admin.
# When this email signs in with verified Google OAuth, they become the initial Admin.
# Uninvited visitors who sign in with other emails will receive no access.
FIRST_ADMIN_EMAIL="admin@yourcompany.com"

# ------------------------------------------------------------------------------
# 4. Storage (Private Vercel Blob)
# ------------------------------------------------------------------------------
# Token for private Vercel Blob store.
# Uploads (avatars, evidence screenshots) up to 3MB are stored privately and
# served strictly through authenticated routes checking active workspace membership.
# When running locally without this token, files fall back to private local storage.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
